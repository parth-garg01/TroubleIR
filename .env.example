# TroubleIR environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Model to use for LLM extraction (Groq-hosted)
MODEL_NAME=qwen/qwen3.8-27b

# Sentence Transformers model for dense embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cosine similarity threshold for semantic cache hits (0.0-1.0)
CACHE_SIMILARITY_THRESHOLD=0.85

# Minimum fraction of actions that must pass IDF grounding (0.0-1.0)
GROUNDING_MIN_COVERAGE=0.6

# Minimum IDF-weighted token overlap per step (0.0-1.0)
GROUNDING_STEP_THRESHOLD=0.3

# Number of SIIS documents to retrieve per query
RETRIEVAL_TOP_K=20
